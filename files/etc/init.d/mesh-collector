#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
APP=/opt/mesh/collector.py

start_service() {
    local enabled port stale

    enabled=$(uci -q get belmax.mesh_collector.enabled)
    if [ "$enabled" != "1" ]; then
        logger -t mesh-collector "disabled (belmax.mesh_collector.enabled=0), skip"
        return 0
    fi

    port=$(uci -q get belmax.mesh_collector.port)
    port=${port:-8080}
    stale=$(uci -q get belmax.mesh_collector.stale_after)
    stale=${stale:-90}

    if [ ! -x "$PROG" ]; then
        logger -t mesh-collector "python3 not installed (python3-light + python3-flask)"
        return 1
    fi
    if [ ! -f "$APP" ]; then
        logger -t mesh-collector "$APP not found"
        return 1
    fi

    mkdir -p /tmp/mesh-data

    procd_open_instance
    procd_set_param command "$PROG" "$APP"
    procd_set_param env COLLECTOR_PORT="$port" STALE_AFTER="$stale" DATA_DIR=/tmp/mesh-data
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "belmax"
}