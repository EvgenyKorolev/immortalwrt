#!/bin/sh /etc/rc.common

START=99
STOP=20
USE_PROCD=1
NAME=block-node

start_service() 
{
    procd_open_instance block-node
    procd_set_param command /usr/sbin/wpa_cli -a /usr/bin/block-node -r
    procd_set_param respawn 3600 1 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    
    /usr/bin/block-node apply
}
